{
  "name": "linux-ai-connector",
  "version": "0.1.0",
  "private": true,
  "description": "AI powered Linux server connector built with Electron and Vite.",
  "main": "electron/bootstrap.js",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepack": "rm -rf release",
    "pack:dir": "npm run prepack && pnpm build && electron-builder --dir",
    "dist:mac": "npm run prepack && pnpm build && electron-builder --mac",
    "dist:win": "npm run prepack && pnpm build && electron-builder --win",
    "preview": "electron-vite preview",
    "lint": "electron-vite build"
  },
  "build": {
    "appId": "com.kernel.ai.connector",
    "productName": "Kernel AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/bootstrap.js",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "element-plus": "^2.14.2",
    "monaco-editor": "^0.52.0",
    "pinia": "^2.3.0",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0"
  }
}
